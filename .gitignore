# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# OS / editor cruft
.DS_Store
.vscode/
.idea/

# Third-party code & run outputs
third_party/
runs/

# Downscaler (PyTorch stack) — runtime artifacts only.
# NB: downscaler/data/ and downscaler/model/ are CODE (python packages), not data.
downscaler/checkpoints/
downscaler/outputs/
downscaler/norm_stats/
downscaler/wandb/
# derived: bash/02_build_index_and_stats.sh rebuilds it from what's on disk
downscaler/valid_timestamps.txt
# Slurm writes job logs here. The DIRECTORY must exist at submit time (sbatch resolves
# --output before the job script runs), hence the tracked .gitkeep — ignore only its
# contents.
downscaler/logs/*
!downscaler/logs/.gitkeep
# Per-run metrics JSONL (configs/logging/local.yaml). Same deal as logs/: the directory is
# tracked via .gitkeep, the run output is not.
downscaler/metrics/*
!downscaler/metrics/.gitkeep

# Data & large outputs (uncomment if you don't want to track these)
# *.nc
# *.zarr/
# data/    <-- do NOT uncomment: it would also ignore downscaler/data/, which is source code
us_prob_forecast_2026.h5

# Learn-quiz session state (local study notes, not project code)
.learn-quiz/

# Vendored Notion export of Vayuh's "Customer Insights (Non-Smooth)" deck (149 PNGs,
# ~11 MB). Reference material for aires/INSIGHTS_PLAN.md, not project source; keep it
# out of repo history.
docs/vayuh_customer_insights/

# The embedded deck: scripts/embed_insights.py inlines 60 figures as data URIs, so the
# output is ~12 MB and regenerates from the template plus figures/ on demand. Track
# docs/aires_insights_template.html, not this. Same split as docs/aires_pilot.html, whose
# embedded form scripts/embed_figs.py writes to a caller-supplied path.
docs/aires_insights.html
